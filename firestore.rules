/**
 * This ruleset enforces a strict multi-tenant security model for the TenantFlow platform.
 *
 * Core Philosophy:
 * The primary security goal is tenant isolation. All data for a specific tenant is
 * stored under the `/tenants/{tenantId}` path. A user's access to any document
 * within this path is determined by their ownership of the tenant.
 *
 * Data Structure:
 * Data is organized with a top-level `tenants` collection.
 *
 * Key Security Decisions:
 * - Default Deny: All operations are denied by default.
 * - Tenant Ownership Required: Access to a tenant document is restricted to the user who created it, identified by the `userId` field.
 * - Secure Listing: Users can only list tenants they own. A general query to list all tenants is denied to protect privacy.
 * - Role-Based Management: The admin role is assigned based on the user's email at the time of profile creation.
 *
 * Authorization:
 * Authorization is based on the `userId` field within each tenant document. Rules check if the `request.auth.uid` matches the `userId` of the document being accessed or queried. This is a secure and performant way to handle ownership-based permissions.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the user making the request is the owner of the tenant document.
     * The resource is the document being accessed.
     */
    function isOwner(resource) {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }

    /**
     * Validates that the user ID in the created document matches the creator's UID.
     */
    function isCreatingOwnResource() {
      return isSignedIn() && request.auth.uid == request.resource.data.userId;
    }
    
    /**
     * Validates that a query on the tenants collection is filtering by the user's own UID.
     * This allows a user to list their own tenants without being able to see all tenants.
     */
    function isQueryingOwnTenants() {
      return isSignedIn() && request.query.where.userId == request.auth.uid;
    }


    // ------------------------------------------------------------------------
    // Collection Rules
    // ------------------------------------------------------------------------
    
    /**
     * @description Manages user profile documents.
     * @path /users/{userId}
     * @allow (read) Any signed-in user can read any profile.
     * @allow (create/update) A user can only write to their own profile.
     */
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Manages tenant documents.
     * @path /tenants/{tenantId}
     * @allow (get/update/delete) The user who owns the tenant document.
     * @allow (list) Only allows querying for tenants owned by the current user.
     * @allow (create) Any signed-in user, as long as they set themselves as the owner.
     */
    match /tenants/{tenantId} {
      allow get, update, delete: if isOwner(resource);
      allow list: if isQueryingOwnTenants();
      allow create: if isCreatingOwnResource();
    }
  }
}
