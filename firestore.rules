rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // This function may need to be adjusted or removed if auth is disabled.
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      // No users can be created or managed if auth is disabled.
      allow read, write: if false;
    }

    match /tenants/{tenantId} {
      // Allow public read access and creation since auth is disabled.
      // You may want to tighten these rules for production.
      allow read, create: if true; 
      // Updates and deletes are disallowed for now.
      allow update, delete: if false;
    }
  }
}
